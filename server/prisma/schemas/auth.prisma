model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  avatarUrl    String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Authentication
  profile       Profile?
  settings      Settings?
  sessions      Session[]
  accounts      Account[]

  // Friends
  sentFriendRequests     FriendRequest[] @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestReceiver")
  friendsA               Friend[]        @relation("FriendUserA")
  friendsB               Friend[]        @relation("FriendUserB")
  blockedUsers           Block[]         @relation("Blocker")
  blockedBy              Block[]         @relation("Blocked")

  // Chat
  chatParticipants       ChatParticipant[]
  messages               Message[]
  reactions              Reaction[]
  readReceipts           ReadReceipt[]
  messageTranslations    MessageTranslation[]

  // Voice Rooms
  voiceRooms             VoiceRoom[]
  voiceParticipants      VoiceParticipant[]
  recordings             Recording[]

  // Communities
  ownedCommunities       Community[]
  communityMembers       CommunityMember[]
  communityRoles         CommunityRole[]
  communityBans          CommunityBan[]
  threads                Thread[]

  // Teacher
  teacher                Teacher?
  bookings               Booking[]
  liveClasses            LiveClass[]
  homeworks              Homework[]
  homeworkSubmissions    HomeworkSubmission[]
  reviews                Review[]
  schedules              Schedule[]

  // Courses
  enrollments            Enrollment[]
  lessonProgress         LessonProgress[]
  quizAttempts           QuizAttempt[]
  assignmentSubmissions  AssignmentSubmission[]
  certificates           Certificate[]

  // Learning
  vocabularies           Vocabulary[]
  flashcards             Flashcard[]
  flashcardReviews       FlashcardReview[]
  spacedRepetitions      SpacedRepetition[]
  progress               Progress[]
  learningStreak         Streak?
  exercises              Exercise[]

  // AI
  aiChats                AiChat[]
  aiSessions             AiSession[]
  aiFeedbacks            AiFeedback[]
  recommendations        Recommendation[]
  studyPlans             StudyPlan[]
  analyses               Analysis[]

  // Gamification
  xpTransactions         XpTransaction[]
  userBadges             UserBadge[]
  challengeProgress      ChallengeProgress[]
  leaderboardEntries     Leaderboard[]
  gamificationStreak     GamificationStreak?

  // Marketplace
  products               Product[]
  carts                  Cart[]
  orders                 Order[]
  wishlists              Wishlist[]
  productReviews         ProductReview[]

  // Payments
  payments               Payment[]
  subscriptions          Subscription[]
  invoices               Invoice[]
  payouts                Payout[]

  // Moderation
  reports                Report[]
  moderationLogs         ModerationLog[]

  // Analytics
  analytics              UserAnalytics?
  learningAnalytics      LearningAnalytics[]

  // Notifications
  notifications          Notification[]
  notificationPreference NotificationPreference?
  pushTokens             PushToken[]
}

model Session {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([userId])
}

model Account {
  id                String   @id @default(cuid())

  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          String
  providerAccountId String
  type              String

  accessToken       String?
  refreshToken      String?
  expiresAt         Int?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}