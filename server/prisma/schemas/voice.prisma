enum VoiceRoomType {
  OPEN
  PRIVATE
  SCHEDULED
  STAGE
}

enum RoomStatus {
  WAITING
  ACTIVE
  ENDED
  CANCELLED
}

enum ParticipantRole {
  HOST
  MODERATOR
  SPEAKER
  LISTENER
}

model VoiceRoom {
  id                 String              @id @default(cuid())
  name               String
  description        String?
  language           String?
  topic              String?
  type               VoiceRoomType       @default(OPEN)
  status             RoomStatus          @default(WAITING)
  creatorId          String
  creator            User                @relation("RoomCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  scheduledFor       DateTime?
  startedAt          DateTime?
  endedAt            DateTime?
  maxParticipants    Int                 @default(50)
  currentParticipants Int                @default(0)
  isRecording        Boolean             @default(false)
  isLocked           Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  participants       VoiceParticipant[]
  recordings         Recording[]
  stages             Stage[]

  @@index([creatorId])
  @@index([status])
  @@index([scheduledFor])
}

model VoiceParticipant {
  id                 String              @id @default(cuid())
  roomId             String
  room               VoiceRoom           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role               ParticipantRole     @default(LISTENER)
  isMuted            Boolean             @default(false)
  isDeafened         Boolean             @default(false)
  raisedHand         Boolean             @default(false)
  speakingTime       Int                 @default(0)
  joinedAt           DateTime            @default(now())
  leftAt             DateTime?

  @@unique([roomId, userId])
  @@index([userId])
}

model Stage {
  id                 String      @id @default(cuid())
  roomId             String
  room               VoiceRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([roomId])
}

model Recording {
  id                 String      @id @default(cuid())
  roomId             String
  room               VoiceRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  url                String
  duration           Int
  size               Int
  transcript         String?
  transcriptLanguage String?
  createdAt          DateTime    @default(now())

  @@index([roomId])
}