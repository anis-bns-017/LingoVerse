enum AiRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AiSessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AiSessionType {
  CHAT
  SPEAKING
  PRONUNCIATION
  ESSAY
  TRANSLATION
  VOCABULARY
  GRAMMAR
}

enum RecommendationType {
  COURSE
  LESSON
  TEACHER
  VOCABULARY
  COMMUNITY
  LIVE_CLASS
}

enum AnalysisType {
  PRONUNCIATION
  GRAMMAR
  VOCABULARY
  FLUENCY
  SPEAKING
  WRITING
  LISTENING
  READING
}

model AiChat {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  language    String?
  model       String?
  isPinned    Boolean     @default(false)
  isArchived  Boolean     @default(false)
  messages    AiMessage[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
}

model AiMessage {
  id                String    @id @default(cuid())
  chatId            String
  chat              AiChat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role              AiRole
  content           String
  promptTokens      Int?
  completionTokens  Int?
  totalTokens       Int?
  latency           Int?
  cost              Decimal?  @db.Decimal(10, 4)
  createdAt         DateTime  @default(now())

  @@index([chatId])
}

model AiSession {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        AiSessionType
  language    String
  status      AiSessionStatus  @default(ACTIVE)
  duration    Int?
  startedAt   DateTime         @default(now())
  endedAt     DateTime?
  feedbacks   AiFeedback[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
}

model AiFeedback {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String?
  session     AiSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  feedback    String
  rating      Int?
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([sessionId])
}

model Recommendation {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType    RecommendationType
  itemId      String
  score       Decimal             @db.Decimal(5,4)
  reason      String?
  seen        Boolean             @default(false)
  clicked     Boolean             @default(false)
  dismissed   Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
}

model StudyPlan {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  language           String
  dailyGoalMinutes   Int
  schedule           Json
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
}

model Analysis {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        AnalysisType
  score       Decimal       @db.Decimal(5,2)
  feedback    String?
  details     Json?
  createdAt   DateTime      @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}