model Community {
  id          String   @id @default(cuid())
  name        String
  description String?
  avatarUrl   String?
  bannerUrl   String?
  ownerId     String
  owner       User     @relation("CommunityCreator", fields: [ownerId], references: [id], onDelete: Cascade)
  type        CommunityType @default(PUBLIC)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  channels    Channel[]
  members     CommunityMember[]
  bans        CommunityBan[]
  roles       CommunityRole[]
}

enum CommunityType {
  PUBLIC
  PRIVATE
  RESTRICTED
}

model Channel {
  id          String   @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name        String
  description String?
  type        ChannelType @default(TEXT)
  parentId    String?
  parent      Channel?  @relation("ChannelParent", fields: [parentId], references: [id])
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  threads     Thread[]
}

enum ChannelType {
  TEXT
  VOICE
  ANNOUNCEMENT
  CATEGORY
}

model Thread {
  id          String   @id @default(cuid())
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  title       String
  content     String?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isLocked    Boolean  @default(false)
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    Message[]  // we already have Message in chat, we can reuse or create ThreadMessage separately. For simplicity, I'll keep as separate.
}

// Actually we can reuse Message model by adding a threadId nullable, but let's keep separate for clarity.
model ThreadMessage {
  id         String   @id @default(cuid())
  threadId   String
  thread     Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CommunityMember {
  id          String   @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   @default("member")
  joinedAt    DateTime @default(now())
  lastActive  DateTime @default(now())

  @@unique([communityId, userId])
}

model CommunityRole {
  id          String   @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name        String
  color       String?
  permissions String[]
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CommunityBan {
  id          String   @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason      String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  createdBy   String

  @@unique([communityId, userId])
}