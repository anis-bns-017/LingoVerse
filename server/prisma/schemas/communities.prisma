enum CommunityType {
  PUBLIC
 PRIVATE
  RESTRICTED
}

enum ChannelType {
  TEXT
  VOICE
  ANNOUNCEMENT
  CATEGORY
}

enum CommunityMemberRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

model Community {
  id          String              @id @default(cuid())
  name        String
  description String?
  avatarUrl   String?
  bannerUrl   String?
  ownerId     String
  owner       User                @relation("CommunityCreator", fields: [ownerId], references: [id], onDelete: Cascade)
  type        CommunityType       @default(PUBLIC)
  channels    Channel[]
  members     CommunityMember[]
  bans        CommunityBan[]
  roles       CommunityRole[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([ownerId])
}

model Channel {
  id            String       @id @default(cuid())
  communityId   String
  community     Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  type          ChannelType  @default(TEXT)
  parentId      String?
  parent        Channel?     @relation("ChannelHierarchy", fields: [parentId], references: [id])
  children      Channel[]    @relation("ChannelHierarchy")
  position      Int          @default(0)
  threads       Thread[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([communityId])
  @@index([parentId])
}

model Thread {
  id          String            @id @default(cuid())
  channelId   String
  channel     Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId    String
  author      User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  content     String?
  isLocked    Boolean           @default(false)
  isPinned    Boolean           @default(false)
  messages    ThreadMessage[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([channelId])
  @@index([authorId])
}

model ThreadMessage {
  id          String      @id @default(cuid())
  threadId    String
  thread      Thread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId    String
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([threadId])
  @@index([authorId])
}

model CommunityMember {
  id           String                @id @default(cuid())
  communityId  String
  community    Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         CommunityMemberRole   @default(MEMBER)
  joinedAt     DateTime              @default(now())
  lastActive   DateTime              @default(now())

  @@unique([communityId, userId])
  @@index([communityId])
  @@index([userId])
}

model CommunityRole {
  id           String      @id @default(cuid())
  communityId  String
  community    Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name         String
  color        String?
  permissions  String[]
  position     Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([communityId])
}

model CommunityBan {
  id           String      @id @default(cuid())
  communityId  String
  community    Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User        @relation("CommunityBanCreator", fields: [createdById], references: [id], onDelete: Cascade)
  reason       String?
  expiresAt    DateTime?
  createdAt    DateTime    @default(now())

  @@unique([communityId, userId])
  @@index([communityId])
  @@index([userId])
  @@index([createdById])
}