enum LanguageLevel {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
  NATIVE
}

enum SkillType {
  VOCABULARY
  GRAMMAR
  SPEAKING
  LISTENING
  READING
  WRITING
  PRONUNCIATION
}

model UserAnalytics {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalStudyTime     Int      @default(0) // minutes
  speakingHours      Float    @default(0)
  totalLessons       Int      @default(0)
  totalExercises     Int      @default(0)
  totalVocabulary    Int      @default(0)
  currentStreak      Int      @default(0)
  longestStreak      Int      @default(0)
  weakAreas          String[]
  strongAreas        String[]
  languageLevels     Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId])
  @@index([userId])
}

model DailyMetric {
  id                 String   @id @default(cuid())
  date               DateTime @unique
  activeUsers        Int      @default(0)
  newUsers           Int      @default(0)
  totalSessions      Int      @default(0)
  totalMessages      Int      @default(0)
  totalVoiceMinutes  Int      @default(0)
  totalStudyMinutes  Int      @default(0)
  totalRevenue       Decimal  @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([date])
}

model WeeklyReport {
  id                 String   @id @default(cuid())
  weekStart          DateTime @unique
  activeUsers        Int      @default(0)
  newUsers           Int      @default(0)
  retentionRate      Float    @default(0)
  avgSessionLength   Float    @default(0)
  totalStudyMinutes  Int      @default(0)
  topLanguages       String[]
  revenue            Decimal  @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([weekStart])
}

model LearningAnalytics {
  id                   String          @id @default(cuid())
  userId               String
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  language             String
  skill                SkillType
  level                LanguageLevel?
  score                Float
  accuracy             Float?
  timeSpent            Int             // minutes
  exercisesCompleted   Int             @default(0)
  lessonsCompleted     Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([userId])
  @@index([language])
  @@index([skill])
}