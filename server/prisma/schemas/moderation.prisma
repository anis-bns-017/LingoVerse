enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  REJECTED
}

enum FlagStatus {
  FLAGGED
  REVIEWED
  APPROVED
  REMOVED
}

enum ReportTargetType {
  USER
  MESSAGE
  COMMUNITY
  COURSE
  THREAD
  PRODUCT
  REVIEW
}

enum ModerationAction {
  WARN
  MUTE
  DELETE
  BAN
  SUSPEND
}

enum ModerationRuleType {
  TOXICITY
  SPAM
  HATE_SPEECH
  HARASSMENT
  SCAM
  NSFW
}

enum SeverityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Report {
  id                String           @id @default(cuid())
  reporterId        String
  reporter          User             @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType        ReportTargetType
  targetId          String
  reason            String
  description       String?
  status            ReportStatus     @default(PENDING)
  moderationLogs    ModerationLog[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([reporterId])
  @@index([status])
  @@index([targetType, targetId])
}

model FlaggedContent {
  id           String           @id @default(cuid())
  contentId    String
  contentType  ReportTargetType
  reason       String
  flaggedBy    String?
  status       FlagStatus       @default(FLAGGED)
  resolvedAt   DateTime?
  resolvedBy   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([contentType, contentId])
  @@index([status])
}

model ModerationLog {
  id           String             @id @default(cuid())
  adminId      String
  admin        User               @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action       ModerationAction
  targetType   ReportTargetType
  targetId     String
  reason       String?
  metadata     Json?
  reportId     String?
  report       Report?            @relation(fields: [reportId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())

  @@index([adminId])
  @@index([reportId])
  @@index([targetType, targetId])
}

model ModerationRule {
  id           String              @id @default(cuid())
  name         String              @unique
  description  String?
  type         ModerationRuleType
  severity     SeverityLevel
  action       ModerationAction
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([type])
  @@index([isActive])
}