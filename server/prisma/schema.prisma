generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ IMPORTS ============
import { User, Session, Account }              from "./schemas/auth.prisma";
import { Profile, Settings }                   from "./schemas/profile.prisma";
import { Friend, FriendRequest, Block }        from "./schemas/friends.prisma";
import { Chat, ChatParticipant, Message, Reaction, ReadReceipt, MessageTranslation, MessageAttachment } from "./schemas/chat.prisma";
import { VoiceRoom, VoiceParticipant, Stage, Recording } from "./schemas/voice.prisma";
import { Community, Channel, Thread, CommunityMember, CommunityRole, CommunityBan } from "./schemas/communities.prisma";
import { Teacher, Booking, LiveClass, Homework, HomeworkSubmission, Review, Schedule } from "./schemas/teachers.prisma";
import { Course, Lesson, Quiz, Question, Assignment, AssignmentSubmission, Certificate, Enrollment, LessonProgress, QuizAttempt } from "./schemas/courses.prisma";
import { Language, Vocabulary, Flashcard, FlashcardReview, SpacedRepetition, GrammarRule, Exercise, Progress, Streak as LearningStreak } from "./schemas/learning.prisma";
import { AiChat, AiSession, AiFeedback, Recommendation, StudyPlan, Analysis } from "./schemas/ai.prisma";
import { XpTransaction, UserBadge, Challenge, ChallengeProgress, Streak as GamificationStreak, Leaderboard, Badge } from "./schemas/gamification.prisma";
import { Product, Cart, Order, Wishlist, ProductReview } from "./schemas/marketplace.prisma";
import { Payment, Subscription, Invoice, Payout } from "./schemas/payments.prisma";
import { Report, FlaggedContent, ModerationLog, ModerationRule } from "./schemas/moderation.prisma";
import { UserAnalytics, DailyMetric, WeeklyReport, LearningAnalytics } from "./schemas/analytics.prisma";
import { Notification, NotificationPreference, PushToken } from "./schemas/notifications.prisma";